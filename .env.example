# Скопируйте этот файл в .env и заполните своими значениями.
# .env добавлен в .gitignore и не должен попадать в репозиторий.

# ============================ ВКонтакте ============================
# Ключ доступа сообщества с правом «Сообщения сообщества».
VK_TOKEN=your_community_token_here

# Числовой ID сообщества без минуса (например, 12345678).
VK_GROUP_ID=12345678

# Версия VK API. Можно оставить значение по умолчанию.
VK_API_VERSION=5.199

# ============================ GigaChat ============================
# Authorization Key из кабинета GigaChat API.
# Альтернатива: GIGACHAT_CLIENT_ID + GIGACHAT_CLIENT_SECRET.
GIGACHAT_CREDENTIALS=your_authorization_key_here

# GIGACHAT_API_PERS — физлицо, GIGACHAT_API_B2B — юрлицо с пакетом,
# GIGACHAT_API_CORP — юрлицо по схеме pay-as-you-go.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель генерации: GigaChat-2, GigaChat-2-Pro, GigaChat-2-Max.
GIGACHAT_MODEL=GigaChat-2

# Адреса API. Менять не нужно.
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# Путь к корневому сертификату НУЦ Минцифры, если он не установлен системно.
# Пример: ./certs/russian_trusted_root_ca.pem
GIGACHAT_CA_BUNDLE_FILE=

# Проверка SSL. Отключайте только для локальной отладки.
GIGACHAT_VERIFY_SSL=true

# Параметры генерации.
GIGACHAT_TEMPERATURE=0.5
GIGACHAT_MAX_TOKENS=700
GIGACHAT_TIMEOUT=60

# ============================ Бот ============================
# Ссылка на форму заявки, которую Алина предлагает пользователю.
ZEROCODER_SALES_FORM_URL=https://zerocoder.ru/#popup:call

# Сколько последних пар «вопрос-ответ» помнить.
HISTORY_TURNS=8

# Через сколько минут неактивности очищать историю пользователя.
HISTORY_TTL_MINUTES=180

# Сколько релевантных разделов базы знаний добавлять в промпт.
KB_TOP_K=6

# Максимальный объём контекста базы знаний в символах.
KB_MAX_CHARS=14000

# DEBUG, INFO, WARNING, ERROR или CRITICAL.
LOG_LEVEL=INFO
